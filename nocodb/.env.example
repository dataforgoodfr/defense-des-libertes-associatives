# Variables de l'app NocoDB sur Clever Cloud (à définir avec `clever env set`).
# Ne jamais committer de vraies valeurs.

# Base de données : rien à définir. Lier l'add-on PostgreSQL à l'app injecte les
# POSTGRESQL_ADDON_*, et start-clever.sh en déduit NC_DB.

# Secret de signature des sessions. Sans lui, NocoDB en génère un à chaque
# démarrage et tout le monde est déconnecté à chaque redéploiement.
# Générer avec : openssl rand -hex 32
NC_AUTH_JWT_SECRET=

# URL publique de l'app (liens d'invitation, e-mails, partages).
NC_PUBLIC_URL=https://nocodb-sma.cleverapps.io

# Désactive l'envoi de statistiques d'usage à NocoDB.
NC_DISABLE_TELE=true

# Clever Cloud : construire l'image depuis le dossier nocodb/ du dépôt.
CC_APP_FOLDER=nocodb
